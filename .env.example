# AI Systematic Review Agent - API Keys
# Copy this file to .env and add your API keys for the models you want to use

# ========================================
# OPENAI MODELS
# ========================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ========================================
# ANTHROPIC CLAUDE MODELS
# ========================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ========================================
# GOOGLE GEMINI MODELS
# ========================================
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ========================================
# DEEPSEEK MODELS (OPTIONAL)
# ========================================
# DeepSeek works without an API key for basic usage, but you can get one for higher limits
# Get your API key from: https://platform.deepseek.com/api_docs
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ========================================
# NOTES
# ========================================
# - If you don't set any API keys, the app will automatically use FREE models like DeepSeek
# - Free models work immediately without any setup
# - The app will automatically detect which models are available
# - Your API keys are only stored locally and never sent anywhere
